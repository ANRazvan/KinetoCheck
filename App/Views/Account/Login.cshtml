@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="auth-shell">
    <section class="auth-card panel-card">
        <p class="panel-kicker">Welcome back</p>
        <h1>Log in</h1>
        <p>Sign in to save your uploads, statistics, and improvement history.</p>

        <form asp-action="Login" method="post" class="auth-form">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control form-control-lg" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control form-control-lg" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100">Log in</button>
        </form>

        <p class="mt-3 mb-0">No account yet? <a asp-action="Register">Register</a></p>
    </section>
</div>