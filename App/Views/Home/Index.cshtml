@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Upload Video for Analysis</h1>
    <p>Choose a video (MP4/MOV) and upload it to analyze with the KinetoCheck model.</p>

    <form asp-controller="Home" asp-action="UploadVideo" method="post" enctype="multipart/form-data">
        <div class="form-group">
            <label for="exerciseId">Exercise to assess</label>
            <select id="exerciseId" name="exercise_id" class="form-control" required>
                <option value="auto" selected="@(ViewBag.SelectedExerciseId == "auto")">System auto-detect</option>
                @foreach (var exercise in (IEnumerable<dynamic>)ViewBag.AvailableExercises)
                {
                    <option value="@exercise.Id" selected="@(ViewBag.SelectedExerciseId?.ToString() == exercise.Id.ToString())">
                        @exercise.Name
                    </option>
                }
            </select>
        </div>

        <div class="form-group">
            <label for="videoFile">Video file</label>
            <input type="file" name="videoFile" id="videoFile" class="form-control" accept="video/*" required />
        </div>
        <div class="form-group mt-2">
            <button type="submit" class="btn btn-primary">Upload & Analyze</button>
        </div>
    </form>

    @if (ViewBag.HasAnalysisResult == true)
    {
        <div class="card mt-4 mx-auto" style="max-width:720px">
            <div class="card-body">
                <h5 class="card-title">Analysis Result</h5>
                <p><strong>Assessment target:</strong> @ViewBag.AssessedExercise</p>
                <p><strong>Score:</strong> @ViewBag.Score</p>
                <p><strong>Prediction:</strong> @ViewBag.Label</p>
                <p><strong>Worst joints:</strong> @ViewBag.WorstJoints</p>
                @if (ViewBag.AnnotatedVideoUrl != null)
                {
                    <div class="mt-3">
                        <video controls style="width:100%; max-width: 100%; border-radius: 8px;">
                            <source src="@ViewBag.AnnotatedVideoUrl" type="video/mp4" />
                        </video>
                        <div class="mt-2">
                            <a class="btn btn-outline-secondary" href="@ViewBag.AnnotatedVideoUrl" download>Download annotated video</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

</div>
