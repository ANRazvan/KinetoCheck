@page
@model IndexModel
@{
    ViewData["Title"] = "Movement Analysis";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <h2 class="mb-4">KinetoCheck &mdash; Movement Correctness Analysis</h2>

        @* ── Backend status ── *@
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Backend Status</h5>
                @if (Model.BackendOnline)
                {
                    <span class="badge bg-success">Online</span>
                    <span class="ms-2 text-muted">v@(Model.BackendVersion) &bull; Model: <strong>@Model.ActiveModel</strong></span>
                }
                else
                {
                    <span class="badge bg-danger">Offline</span>
                    <span class="ms-2 text-muted">Make sure the FastAPI backend is running on <code>@Model.BackendUrl</code></span>
                }
            </div>
        </div>

        @* ── Upload form ── *@
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Upload a Video</h5>
                <p class="text-muted">Select a video of a person performing an exercise. The model will predict whether the movement is <strong>correct</strong> or <strong>incorrect</strong>.</p>

                <form method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label" for="exerciseSelect">Exercise Type</label>
                        <select class="form-select" id="exerciseSelect" name="SelectedExerciseKey" required>
                            <option value="" disabled selected>-- Select an exercise --</option>
                            @foreach (var ex in Model.Exercises)
                            {
                                var key = $"{ex.Dataset}:{ex.Id}";
                                var datasetLabel = ex.Dataset.Equals("uiprmd", StringComparison.OrdinalIgnoreCase)
                                    ? "UI-PRMD"
                                    : "IntelliRehab";
                                <option value="@key"
                                        selected="@(key == Model.SelectedExerciseKey)"
                                        title="@(ex.HasWeights ? "Trained model available" : "No trained model yet")">
                                    [@datasetLabel] @ex.Name @(ex.HasWeights ? "" : "(no weights)")
                                </option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="videoFile">Video File</label>
                        <input class="form-control" type="file" id="videoFile" name="videoFile" accept="video/*" required />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary" @(Model.BackendOnline ? "" : "disabled")>
                            Analyze Movement
                        </button>
                        <button type="submit" class="btn btn-success" formaction="?handler=AnalyzeWithAnnotatedVideo" @(Model.BackendOnline ? "" : "disabled")>
                            Analyze with Visual Feedback
                        </button>
                    </div>
                </form>
            </div>
        </div>

        @* ── Prediction result ── *@
        @if (Model.Prediction != null)
        {
            var isCorrect = Model.Prediction.Label.Equals("correct", StringComparison.OrdinalIgnoreCase);
            <div class="card border-@(isCorrect ? "success" : "danger") mb-4">
                <div class="card-header bg-@(isCorrect ? "success" : "danger") text-white">
                    Prediction Result
                </div>
                <div class="card-body text-center">
                    <h3 class="card-title">
                        @(isCorrect ? "\u2705" : "\u274C")
                        @Model.Prediction.Label.ToUpperInvariant()
                    </h3>
                    <p class="display-6">@($"{Model.Prediction.Confidence * 100:F1}%") confidence</p>
                    @if (!string.IsNullOrEmpty(Model.Prediction.ExerciseName))
                    {
                        <p class="text-muted mt-2">
                            Exercise: <strong>@Model.Prediction.ExerciseName</strong>
                            @if (!string.IsNullOrEmpty(Model.Prediction.Dataset))
                            {
                                <span class="badge bg-secondary ms-2">@Model.Prediction.Dataset</span>
                            }
                        </p>
                    }
                </div>

                @* ── Problematic Joints ── *@
                @if (Model.Prediction.ProblematicJoints?.Any() == true)
                {
                    <div class="card-body border-top">
                        <h5 class="card-title">
                            <span class="text-warning">⚠️</span> Problematic Joints Detected
                        </h5>
                        <p class="text-muted">These joints showed significant deviation from the correct reference movement:</p>
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @foreach (var joint in Model.Prediction.ProblematicJoints)
                            {
                                <span class="badge bg-warning text-dark">@joint</span>
                            }
                        </div>
                    </div>
                }

                @* ── Joint Deviations ── *@
                @if (Model.Prediction.JointDeviations?.Any() == true)
                {
                    <div class="card-body border-top">
                        <h5 class="card-title">Joint Deviation Scores</h5>
                        <p class="text-muted small">Higher scores indicate larger deviations from correct form (0.0 = perfect, 1.0 = max deviation)</p>
                        <div class="row">
                            @foreach (var (joint, deviation) in Model.Prediction.JointDeviations.OrderByDescending(kv => kv.Value).Take(10))
                            {
                                var colorClass = deviation > 0.15 ? "text-danger" : (deviation > 0.10 ? "text-warning" : "text-success");
                                <div class="col-md-6 mb-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="@colorClass"><strong>@joint</strong></span>
                                        <span class="badge bg-secondary">@($"{deviation:F3}")</span>
                                    </div>
                                    <div class="progress" style="height: 6px;">
                                        <div class="progress-bar @(deviation > 0.15 ? "bg-danger" : (deviation > 0.10 ? "bg-warning" : "bg-success"))"
                                             role="progressbar"
                                             style="width: @($"{Math.Min(deviation * 100, 100):F0}%")"
                                             aria-valuenow="@deviation"
                                             aria-valuemin="0"
                                             aria-valuemax="1"></div>
                                    </div>
                                </div>
                            }
                        </div>
                        @if (Model.Prediction.JointDeviations.Count > 10)
                        {
                            <p class="text-muted small mt-2">Showing top 10 out of @Model.Prediction.JointDeviations.Count joints</p>
                        }
                    </div>
                }
            </div>
        }

        @* ── Annotated Video ── *@
        @if (Model.AnnotatedVideo != null && Model.HasAnnotatedVideo)
        {
            <div class="card border-info mb-4">
                <div class="card-header bg-info text-white">
                    <i class="bi bi-camera-video"></i> Annotated Movement Video
                </div>
                <div class="card-body">
                    <p class="text-muted">Visual feedback with color-coded skeleton overlay:</p>
                    <ul class="small">
                        <li><span class="text-success">Green:</span> Joint position is correct</li>
                        <li><span class="text-warning">Yellow/Orange:</span> Moderate deviation from correct form</li>
                        <li><span class="text-danger">Red:</span> Significant deviation - needs correction</li>
                    </ul>
                    
                    <video controls class="w-100 mb-3" style="max-height: 500px;">
                        <source src="?handler=StreamAnnotatedVideo&videoId=@Model.VideoId" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>

                    <a href="?handler=DownloadAnnotatedVideo&videoId=@Model.VideoId" class="btn btn-info">
                        <i class="bi bi-download"></i> Download Annotated Video
                    </a>
                </div>
            </div>
        }
        else if (Model.Prediction != null && Model.Prediction.ProblematicJoints?.Any() == true)
        {
            <div class="alert alert-info">
                <strong>Note:</strong> Annotated video was not generated. Use the "Analyze with Visual Feedback" button to see the skeleton overlay.
            </div>
        }

        @* ── Error message ── *@
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

    </div>
</div>
