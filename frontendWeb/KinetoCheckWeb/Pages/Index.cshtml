@page
@model IndexModel
@{
    ViewData["Title"] = "Movement Analysis";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <h2 class="mb-4">KinetoCheck &mdash; Movement Correctness Analysis</h2>

        @* ── Backend status ── *@
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Backend Status</h5>
                @if (Model.BackendOnline)
                {
                    <span class="badge bg-success">Online</span>
                    <span class="ms-2 text-muted">v@(Model.BackendVersion) &bull; Model: <strong>@Model.ActiveModel</strong></span>
                }
                else
                {
                    <span class="badge bg-danger">Offline</span>
                    <span class="ms-2 text-muted">Make sure the FastAPI backend is running on <code>@Model.BackendUrl</code></span>
                }
            </div>
        </div>

        @* ── Upload form ── *@
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Upload a Video</h5>
                <p class="text-muted">Select a video of a person performing an exercise. The model will predict whether the movement is <strong>correct</strong> or <strong>incorrect</strong>.</p>

                <form method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label" for="exerciseSelect">Exercise Type</label>
                        <select class="form-select" id="exerciseSelect" name="SelectedExerciseKey" required>
                            <option value="" disabled selected>-- Select an exercise --</option>
                            @foreach (var ex in Model.Exercises)
                            {
                                var key = $"{ex.Dataset}:{ex.Id}";
                                var datasetLabel = ex.Dataset.Equals("uiprmd_2d", StringComparison.OrdinalIgnoreCase)
                                    ? "UI-PRMD 2D"
                                    : ex.Dataset.Equals("intellirehab_2d", StringComparison.OrdinalIgnoreCase)
                                        ? "IntelliRehab 2D"
                                    : ex.Dataset.Equals("uiprmd", StringComparison.OrdinalIgnoreCase)
                                        ? "UI-PRMD"
                                        : "IntelliRehab";
                                <option value="@key"
                                        selected="@(key == Model.SelectedExerciseKey ? "selected" : null)"
                                        title="@(ex.HasWeights ? "Trained model available" : "No trained model yet")">
                                    [@datasetLabel] @ex.Name @(ex.HasWeights ? "" : "(no weights)")
                                </option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="videoFile">Video File</label>
                        <input class="form-control" type="file" id="videoFile" name="videoFile" accept="video/*" required />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary" @(Model.BackendOnline ? "" : "disabled")>
                            Analyze Movement
                        </button>
                        <button type="submit" class="btn btn-success" formaction="?handler=AnalyzeWithAnnotatedVideo" @(Model.BackendOnline ? "" : "disabled")>
                            Analyze with Visual Feedback
                        </button>
                        <button type="submit" class="btn btn-dark" formaction="?handler=AnalyzeTimeline" @(Model.BackendOnline ? "" : "disabled")>
                            Analyze Multi-Exercise Timeline
                        </button>
                    </div>
                </form>
                <p class="small text-muted mt-3 mb-0">
                    Tip: Use "Analyze Multi-Exercise Timeline" when the video contains more than one exercise or multiple repetitions.
                </p>
            </div>
        </div>

        @* ── IntelliRehab reference visualization preview ── *@
        <div id="referencePreviewCard" class="card mb-4 d-none">
            <div class="card-header bg-secondary text-white">
                Reference Exercise Visualization
            </div>
            <div class="card-body">
                <p class="text-muted mb-2">Reference motion for the selected IntelliRehab exercise.</p>
                <video id="referencePreviewVideo" controls class="w-100" style="max-height: 400px;">
                    <source id="referencePreviewSource" src="" type="video/mp4">
                    Your browser does not support the video tag.
                </video>
                <p id="referencePreviewError" class="text-danger small mt-2 d-none">
                    Reference visualization is not available for this exercise.
                </p>
            </div>
        </div>

        @* ── Input video preview ── *@
        @if (Model.HasInputVideo)
        {
            <div class="card border-secondary mb-4">
                <div class="card-header bg-light">
                    Uploaded Video Preview
                </div>
                <div class="card-body">
                    <p class="text-muted mb-2">Original uploaded clip used for analysis.</p>
                    <video controls class="w-100" style="max-height: 420px;">
                        <source src="?handler=StreamInputVideo&videoId=@Model.InputVideoId" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>
            </div>
        }

        @* ── Prediction result ── *@
        @if (Model.Prediction != null)
        {
            var isCorrect = Model.Prediction.Label.Equals("correct", StringComparison.OrdinalIgnoreCase);
            <div class="card border-@(isCorrect ? "success" : "danger") mb-4">
                <div class="card-header bg-@(isCorrect ? "success" : "danger") text-white">
                    Prediction Result
                </div>
                <div class="card-body text-center">
                    <h3 class="card-title">
                        @(isCorrect ? "\u2705" : "\u274C")
                        @Model.Prediction.Label.ToUpperInvariant()
                    </h3>
                    <p class="display-6">@($"{Model.Prediction.Confidence * 100:F1}%") confidence</p>
                    @if (!string.IsNullOrEmpty(Model.Prediction.ExerciseName))
                    {
                        <p class="text-muted mt-2">
                            Exercise: <strong>@Model.Prediction.ExerciseName</strong>
                            @if (!string.IsNullOrEmpty(Model.Prediction.Dataset))
                            {
                                <span class="badge bg-secondary ms-2">@Model.Prediction.Dataset</span>
                            }
                        </p>
                    }
                </div>

                @* ── Problematic Joints ── *@
                @if (Model.Prediction.ProblematicJoints?.Any() == true)
                {
                    <div class="card-body border-top">
                        <h5 class="card-title">
                            <span class="text-warning">⚠️</span> Problematic Joints Detected
                        </h5>
                        <p class="text-muted">These joints showed significant deviation from the correct reference movement:</p>
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @foreach (var joint in Model.Prediction.ProblematicJoints)
                            {
                                <span class="badge bg-warning text-dark">@joint</span>
                            }
                        </div>
                    </div>
                }

                @* ── Joint Deviations ── *@
                @if (Model.Prediction.JointDeviations?.Any() == true)
                {
                    <div class="card-body border-top">
                        <h5 class="card-title">Joint Deviation Scores</h5>
                        <p class="text-muted small">Higher scores indicate larger deviations from correct form (0.0 = perfect, 1.0 = max deviation)</p>
                        <div class="row">
                            @foreach (var (joint, deviation) in Model.Prediction.JointDeviations.OrderByDescending(kv => kv.Value).Take(10))
                            {
                                var colorClass = deviation > 0.15 ? "text-danger" : (deviation > 0.10 ? "text-warning" : "text-success");
                                <div class="col-md-6 mb-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="@colorClass"><strong>@joint</strong></span>
                                        <span class="badge bg-secondary">@($"{deviation:F3}")</span>
                                    </div>
                                    <div class="progress" style="height: 6px;">
                                        <div class="progress-bar @(deviation > 0.15 ? "bg-danger" : (deviation > 0.10 ? "bg-warning" : "bg-success"))"
                                             role="progressbar"
                                             style="width: @($"{Math.Min(deviation * 100, 100):F0}%")"
                                             aria-valuenow="@deviation"
                                             aria-valuemin="0"
                                             aria-valuemax="1"></div>
                                    </div>
                                </div>
                            }
                        </div>
                        @if (Model.Prediction.JointDeviations.Count > 10)
                        {
                            <p class="text-muted small mt-2">Showing top 10 out of @Model.Prediction.JointDeviations.Count joints</p>
                        }
                    </div>
                }
            </div>
        }

        @* ── Annotated Video ── *@
        @if (Model.HasAnnotatedVideo)
        {
            <div class="card border-info mb-4">
                <div class="card-header bg-info text-white">
                    <i class="bi bi-camera-video"></i> Annotated Movement Video
                </div>
                <div class="card-body">
                    <p class="text-muted">Visual feedback with color-coded skeleton overlay:</p>
                    <ul class="small">
                        <li><span class="text-success">Green:</span> Joint position is correct</li>
                        <li><span class="text-warning">Yellow/Orange:</span> Moderate deviation from correct form</li>
                        <li><span class="text-danger">Red:</span> Significant deviation - needs correction</li>
                    </ul>
                    
                    <video controls class="w-100 mb-3" style="max-height: 500px;">
                        <source src="?handler=StreamAnnotatedVideo&videoId=@Model.VideoId" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>

                    <a href="?handler=DownloadAnnotatedVideo&videoId=@Model.VideoId" class="btn btn-info">
                        <i class="bi bi-download"></i> Download Annotated Video
                    </a>
                </div>
            </div>
        }
        else if (Model.Prediction != null && Model.Prediction.ProblematicJoints?.Any() == true)
        {
            <div class="alert alert-info">
                <strong>Note:</strong> Annotated video was not generated. Use the "Analyze with Visual Feedback" button to see the skeleton overlay.
            </div>
        }

        @* ── Error message ── *@
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                <h6 class="mb-2">Analysis Error</h6>
                <p class="mb-2">@Model.ErrorMessage</p>
                <hr />
                <p class="mb-1"><strong>Quick checks:</strong></p>
                <ul class="mb-0 small">
                    <li>Ensure backend is running and online.</li>
                    <li>Try an MP4 video with clear subject visibility.</li>
                    <li>For long or mixed videos, use timeline analysis.</li>
                    <li>If issue persists, check backend logs for details.</li>
                </ul>
            </div>
        }

        @* ── Timeline result ── *@
        @if (Model.TimelineResult != null)
        {
            var totalFrames = Math.Max(Model.TimelineResult.TotalFrames, 1);
            <div class="card border-dark mb-4">
                <div class="card-header bg-dark text-white">
                    Mixed-Exercise Timeline Analysis
                </div>
                <div class="card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <div class="small text-muted">Dataset</div>
                            <div><strong>@Model.TimelineResult.Dataset</strong></div>
                        </div>
                        <div class="col-md-3">
                            <div class="small text-muted">Windows</div>
                            <div><strong>@Model.TimelineResult.NumWindows</strong></div>
                        </div>
                        <div class="col-md-3">
                            <div class="small text-muted">Segments</div>
                            <div><strong>@Model.TimelineResult.NumSegments</strong></div>
                        </div>
                        <div class="col-md-3">
                            <div class="small text-muted">Stride / Window</div>
                            <div><strong>@Model.TimelineResult.Stride / @Model.TimelineResult.WindowSize</strong></div>
                        </div>
                    </div>

                    @if (Model.TimelineResult.Segments?.Any() == true)
                    {
                        <h6 class="mb-3">Detected Exercise Segments</h6>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Exercise</th>
                                        <th>Range (frames)</th>
                                        <th>Duration</th>
                                        <th>Prediction</th>
                                        <th>Confidence</th>
                                        <th>Top problematic joints</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var seg in Model.TimelineResult.Segments)
                                    {
                                        var isCorrectSeg = seg.Prediction?.Label?.Equals("correct", StringComparison.OrdinalIgnoreCase) == true;
                                        var badgeClass = isCorrectSeg ? "bg-success" : "bg-danger";
                                        var widthPct = Math.Clamp((double)seg.DurationFrames / totalFrames * 100.0, 0.5, 100.0);
                                        <tr>
                                            <td>
                                                <strong>@seg.ExerciseName</strong>
                                                <div class="small text-muted">ID @seg.ExerciseId</div>
                                            </td>
                                            <td>@seg.StartFrame - @seg.EndFrame</td>
                                            <td>
                                                @seg.DurationFrames frames
                                                <div class="progress mt-1" style="height: 6px;">
                                                    <div class="progress-bar bg-info" style="width: @($"{widthPct:F1}%")"></div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge @badgeClass">@seg.Prediction?.Label</span>
                                            </td>
                                            <td>@($"{(seg.Prediction?.Confidence ?? 0f) * 100:F1}%")</td>
                                            <td>
                                                @if (seg.Prediction?.ProblematicJoints?.Any() == true)
                                                {
                                                    @string.Join(", ", seg.Prediction.ProblematicJoints.Take(4))
                                                }
                                                else
                                                {
                                                    <span class="text-muted">None</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">
                            No stable segments were detected with current timeline settings.
                        </div>
                    }

                    @if (Model.TimelineAnnotatedClips?.Any() == true)
                    {
                        <hr />
                        <h6 class="mb-3">Annotated Segment Clips</h6>
                        <div class="row g-3">
                            @foreach (var clip in Model.TimelineAnnotatedClips)
                            {
                                var isCorrectClip = clip.Label.Equals("correct", StringComparison.OrdinalIgnoreCase);
                                <div class="col-12">
                                    <div class="border rounded p-3">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div>
                                                <strong>@clip.ExerciseName</strong>
                                                <span class="text-muted ms-2">(frames @clip.StartFrame - @clip.EndFrame)</span>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge @(isCorrectClip ? "bg-success" : "bg-danger")">@clip.Label</span>
                                                <span class="badge bg-secondary">@($"{clip.Confidence * 100:F1}%")</span>
                                            </div>
                                        </div>
                                        <video controls class="w-100" style="max-height: 360px;">
                                            <source src="?handler=StreamAnnotatedVideo&videoId=@clip.VideoId" type="video/mp4">
                                            Your browser does not support the video tag.
                                        </video>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <details class="mt-3">
                        <summary class="text-muted">Show raw window predictions (@Model.TimelineResult.WindowPredictions?.Count windows)</summary>
                        <div class="table-responsive mt-2">
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Frame range</th>
                                        <th>Raw exercise</th>
                                        <th>Smoothed exercise</th>
                                        <th>Score</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var win in Model.TimelineResult.WindowPredictions ?? new())
                                    {
                                        <tr>
                                            <td>@win.StartFrame - @win.EndFrame</td>
                                            <td>@win.ExerciseName</td>
                                            <td>@win.SmoothedExerciseName</td>
                                            <td>@($"{win.Score * 100:F1}%")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </details>
                </div>
            </div>
        }

    </div>
</div>

<script>
    (() => {
        const exerciseSelect = document.getElementById("exerciseSelect");
        const previewCard = document.getElementById("referencePreviewCard");
        const previewVideo = document.getElementById("referencePreviewVideo");
        const previewSource = document.getElementById("referencePreviewSource");
        const previewError = document.getElementById("referencePreviewError");
        let previewObjectUrl = null;

        if (!exerciseSelect || !previewCard || !previewVideo || !previewSource || !previewError) {
            return;
        }

        function hidePreview() {
            previewCard.classList.add("d-none");
            previewError.classList.add("d-none");
            previewError.textContent = "Reference visualization is not available for this exercise.";
            previewVideo.pause();
            previewVideo.removeAttribute("src");
            previewSource.src = "";
            if (previewObjectUrl) {
                URL.revokeObjectURL(previewObjectUrl);
                previewObjectUrl = null;
            }
            previewVideo.load();
        }

        async function showPreview(dataset, exerciseId) {
            if (dataset !== "intellirehab" && dataset !== "intellirehab_2d") {
                hidePreview();
                return;
            }

            const url = `?handler=ReferenceVideo&dataset=${encodeURIComponent(dataset)}&exerciseId=${encodeURIComponent(exerciseId)}&_=${Date.now()}`;
            previewCard.classList.remove("d-none");
            previewError.classList.add("d-none");

            if (previewObjectUrl) {
                URL.revokeObjectURL(previewObjectUrl);
                previewObjectUrl = null;
            }

            try {
                const response = await fetch(url, { cache: "no-store" });
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                const contentType = response.headers.get("content-type") || "";
                if (!contentType.includes("video/")) {
                    throw new Error(`Unexpected content type: ${contentType}`);
                }

                const blob = await response.blob();
                if (!blob || blob.size === 0) {
                    throw new Error("Empty video payload");
                }

                previewObjectUrl = URL.createObjectURL(blob);
                previewVideo.src = previewObjectUrl;
                previewVideo.load();
            } catch (err) {
                previewVideo.removeAttribute("src");
                previewSource.src = "";
                previewVideo.load();
                previewError.textContent = `Reference visualization failed to load (${err?.message || "unknown error"}).`;
                previewError.classList.remove("d-none");
            }
        }

        previewVideo.addEventListener("error", () => {
            previewError.classList.remove("d-none");
            previewError.textContent = "Reference video could not be decoded by the browser.";
        });

        previewVideo.addEventListener("loadedmetadata", () => {
            const duration = Number(previewVideo.duration);
            if (!Number.isFinite(duration) || duration <= 0) {
                previewError.classList.remove("d-none");
                previewError.textContent = "Reference video metadata is invalid (duration unavailable).";
            }
        });

        previewVideo.addEventListener("canplay", () => {
            previewError.classList.add("d-none");
        });

        exerciseSelect.addEventListener("change", () => {
            const selected = exerciseSelect.value || "";
            const parts = selected.split(":");
            if (parts.length !== 2) {
                hidePreview();
                return;
            }
            showPreview(parts[0].toLowerCase(), parts[1]);
        });

        if (exerciseSelect.value) {
            const parts = exerciseSelect.value.split(":");
            if (parts.length === 2) {
                showPreview(parts[0].toLowerCase(), parts[1]);
            }
        }
    })();
</script>
